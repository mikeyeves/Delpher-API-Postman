{
  "info": {
    "_postman_id": "3f23f6cb-5017-489c-abd8-aff380c4d344",
    "name": "Delpher / KB API (Netherlands)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "KB (National Library of the Netherlands) SRU API behind **Delpher**: historic newspapers, family notices, books, magazines and ANP bulletins. No key. Responses are XML.\n\nSRU: https://jsru.kb.nl/sru/sru · Resolver: https://resolver.kb.nl/resolve · Info: https://www.kb.nl/en/research-find/for-researchers/data-services-apis"
  },
  "auth": {
    "type": "noauth"
  },
  "item": [
    {
      "name": "★ Newspapers (DDD_artikel)",
      "id": "3013af9b-d129-49b9-b590-8850cd604756",
      "item": [
        {
          "name": "Newspaper articles — search",
          "id": "fdc07ff5-7b4a-4132-bb1a-a6a0121f71f4",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/xml"
              }
            ],
            "url": {
              "raw": "{{kb_sru}}/sru/sru?version=1.2&operation=searchRetrieve&x-collection=DDD_artikel&recordSchema=ddd&query={{query}}&maximumRecords=50&startRecord=1",
              "host": [
                "{{kb_sru}}"
              ],
              "path": [
                "sru",
                "sru"
              ],
              "query": [
                {
                  "key": "version",
                  "value": "1.2",
                  "disabled": false,
                  "description": ""
                },
                {
                  "key": "operation",
                  "value": "searchRetrieve",
                  "disabled": false,
                  "description": ""
                },
                {
                  "key": "x-collection",
                  "value": "DDD_artikel",
                  "disabled": false,
                  "description": "DDD_artikel (newspaper articles) | DTS_document (books & magazines) | BOEKEN_boek | ANP (radio bulletins)"
                },
                {
                  "key": "recordSchema",
                  "value": "ddd",
                  "disabled": false,
                  "description": "ddd | dc | dcx"
                },
                {
                  "key": "query",
                  "value": "{{query}}",
                  "disabled": false,
                  "description": "CQL query"
                },
                {
                  "key": "maximumRecords",
                  "value": "50",
                  "disabled": false,
                  "description": "max 1000"
                },
                {
                  "key": "startRecord",
                  "value": "1",
                  "disabled": false,
                  "description": "1-based"
                }
              ]
            },
            "description": "Delpher newspapers, 1618 to about 1995: more than 100 million OCR'd articles from Dutch, Antillean, Surinamese and Indonesian papers."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200',()=>pm.expect(pm.response.code).to.eql(200));",
                  "const x=pm.response.text();",
                  "const total=(x.match(/numberOfRecords>(\\d+)/)||[])[1]||'0';",
                  "const g=(r,t)=>((r.match(new RegExp('<'+t+'[^>]*>([^<]*)<'))||[])[1]||'');",
                  "const recs=x.split('<srw:record>').slice(1);",
                  "const rows=recs.map(r=>{const key=g(r,'ddd:metadataKey');const ocr=g(r,'dc:identifier');const page=g(r,'ddd:pageurl');const view=key?`https://www.delpher.nl/nl/kranten/view?coll=ddd&identifier=${encodeURIComponent(key)}`:ocr;return [`<a href=\"${view}\">${g(r,'dc:title').slice(0,110)||'(untitled)'}</a>`,g(r,'dc:date'),g(r,'ddd:papertitle')||g(r,'dc:publisher'),g(r,'dc:type'),g(r,'ddd:spatial'),ocr?`<a href=\"${ocr}\">OCR</a>`:'',page?`<a href=\"http://resolver.kb.nl/resolve?urn=${page}:image\">page</a>`:''];});",
                  "pm.visualizer.set(`<style>table{border-collapse:collapse;font:13px sans-serif}td,th{border:1px solid #ccc;padding:4px 8px;vertical-align:top}th{background:#eee}</style><p><b>{{total}}</b> records</p><table><tr><th>Title</th><th>Date</th><th>Newspaper</th><th>Type</th><th>Area</th><th></th><th></th></tr>{{#each rows}}<tr>{{#each this}}<td>{{{this}}}</td>{{/each}}</tr>{{/each}}</table>`,{rows,total});"
                ]
              }
            }
          ]
        },
